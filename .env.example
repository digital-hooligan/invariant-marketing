# Secrets & Environment Standard v0.1
# Keys only. No real values committed.
# Copy to .env.local and replace CHANGEME values.

# Required by tooling/env-contract (validate.mjs)
ENVIRONMENT=local
PUBLIC_SITE_URL=http://localhost:3000

# Required by DH baseline v0.1 (and required by env-contract per current output)
APP_ID=invariant-marketing
APP_VERSION=0.1.0
BUILD_TIMESTAMP=CHANGEME

# Optional (recognized by env-contract; include for clarity)
LOG_LEVEL=info
NEXT_PUBLIC_ANALYTICS_ID=CHANGEME
NEXT_PUBLIC_FEATURE_FLAGS=CHANGEME
CI=false
SECRETS_SCAN_MODE=off
ENV_CONTRACT_STRICT=false

# Contact form — Resend (used by Server Action in src/app/contact/actions.ts)
# Required for production. If absent in dev, submissions log to console and succeed silently.
# SETUP: Verify your sending domain at resend.com before deploying.
RESEND_API_KEY=__SET_IN_SECRET_STORE__

# Contact intake — SMTP (used by API route at src/app/api/contact/route.ts)
# Required if using the nodemailer-based contact intake flow.
FOUNDER_INBOX_EMAIL=founder@example.com
CONTACT_INTAKE_FROM_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
